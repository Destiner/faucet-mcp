{
  "name": "faucet-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets a coding agent request small dev funds (ETH/WETH/USDC/USDT, SOL/USDC on Solana) with per-call + 24h caps and TOTP approval.",
  "license": "MIT",
  "author": "Timur Badretdinov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Destiner/faucet-mcp.git"
  },
  "bugs": "https://github.com/Destiner/faucet-mcp/issues",
  "homepage": "https://github.com/Destiner/faucet-mcp#readme",
  "bin": {
    "faucet-mcp": "src/server.ts",
    "faucet-setup": "bin/setup.ts"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "setup": "bun run bin/setup.ts",
    "solana-keygen": "bun run bin/solana-keygen.ts",
    "test": "bun test",
    "check": "biome check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@rhinestone/shared-configs": "^2.50.0",
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.6.0",
    "otplib": "^13.6.0",
    "qrcode-terminal": "^0.12.0",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/bun": "^1.4.4",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  }
}
