    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.0",
    "@types/bun": "^1.2.8",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.8.2"
  }
}
