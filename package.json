{
  "name": "faucet-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets a coding agent request small dev funds (ETH/WETH/USDC/USDT) with per-call + 24h caps and TOTP approval.",
  "license": "MIT",
  "author": "Timur Badretdinov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Destiner/faucet-mcp.git"
  },
  "bugs": "https://github.com/Destiner/faucet-mcp/issues",
  "homepage": "https://github.com/Destiner/faucet-mcp#readme",
  "bin": {
    "faucet-mcp": "src/server.ts",
    "faucet-setup": "bin/setup.ts"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "setup": "bun run bin/setup.ts",
    "check": "biome check",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
