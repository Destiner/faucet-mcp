# Hot wallet that holds the faucet funds.
FUNDING_PRIVATE_KEY=0x...

# Solana hot wallet: base58 64-byte secret key (or solana-keygen JSON array).
# `bun run solana-keygen` generates one into .env.
SOLANA_FUNDING_PRIVATE_KEY=

# Base32 TOTP secret (generated by `bun run setup`)
# Same value is also added to Apple Passwords / 1Password as a verification code
FAUCET_TOTP_SECRET=

# Optional: override the state file path (default ~/.faucet/state.json)
# FAUCET_STATE_FILE=

# Optional: override RPC URLs per chain (defaults are public RPCs)
# RPC_URL_1=
# RPC_URL_8453=
# RPC_URL_792703809=   # Solana mainnet
# RPC_URL_792703810=   # Solana devnet
